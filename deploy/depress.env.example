# Ops/render values for deploy/render.sh (the deploy/*.template files).
# Copy this file to /etc/depress/depress.env (or pass any env file path to
# render.sh) and adjust. The Django app ignores keys it does not know.
#
# Only DEPRESS_DOMAIN is mandatory; the rest have defaults in render.sh.

# Public hostname used by nginx and certbot (no scheme, no path).
DEPRESS_DOMAIN=app.example.com

# Where the repository is cloned on the server.
DEPRESS_APP_ROOT=/opt/de-press

# OS user/group that owns the deployment.
DEPRESS_USER=depress
DEPRESS_GROUP=depress

# Runtime env file used by the systemd units (EnvironmentFile).
DEPRESS_ENV_FILE=/etc/depress/depress.env

# Port daphne listens on locally (nginx proxies to it).
DEPRESS_API_PORT=8000

# Postgres database name backed up by depress-backup.service.
DEPRESS_DB_NAME=depress

# Backup directory (owner: postgres).
DEPRESS_BACKUP_DIR=/var/backups/depress

# Web root for the ACME (certbot) HTTP-01 challenge.
ACME_WEBROOT=/var/www/certbot
