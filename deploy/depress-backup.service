[Unit]
Description=de-press Postgres backup (pg_dump -Fc)

[Service]
Type=oneshot
User=postgres
ExecStart=/bin/bash -c 'umask 027 && exec /usr/bin/pg_dump -Fc depress > /var/backups/depress/depress-$$(date +%%F).dump'
ExecStartPost=/usr/bin/find /var/backups/depress -name 'depress-*.dump' -mtime +14 -delete
