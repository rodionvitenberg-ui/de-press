[Unit]
Description=de-press Celery beat (daily Telegram digests)
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=${DEPRESS_USER}
Group=${DEPRESS_GROUP}
WorkingDirectory=${DEPRESS_APP_ROOT}/backend
EnvironmentFile=${DEPRESS_ENV_FILE}
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
ExecStart=${DEPRESS_APP_ROOT}/backend/.venv/bin/celery -A config beat -l info --schedule ${DEPRESS_APP_ROOT}/backend/celerybeat-schedule
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target