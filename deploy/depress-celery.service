[Unit]
Description=de-press Celery worker
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=depress
Group=depress
WorkingDirectory=/opt/de-press/backend
EnvironmentFile=/etc/depress/depress.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
ExecStart=/opt/de-press/backend/.venv/bin/celery -A config worker -l info --concurrency=2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
