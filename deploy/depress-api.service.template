[Unit]
Description=de-press ASGI (daphne)
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=${DEPRESS_USER}
Group=${DEPRESS_GROUP}
WorkingDirectory=${DEPRESS_APP_ROOT}/backend
EnvironmentFile=${DEPRESS_ENV_FILE}
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
ExecStart=${DEPRESS_APP_ROOT}/backend/.venv/bin/daphne -b 127.0.0.1 -p ${DEPRESS_API_PORT} config.asgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target