  "private": true,
  "description": "Shared API client for @de-press/browser and @de-press/mini-app (audit Q3). Ships TS source; apps compile it.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts"
  },
